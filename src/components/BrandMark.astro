---
interface Props {
  size?: number;
  title?: string;
  class?: string;
  variant?: 'default' | 'inverse';
}

const { size = 32, title, class: className, variant = 'default' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  xmlns="http://www.w3.org/2000/svg"
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
  class={[className, `brand-svg brand-svg--${variant}`].filter(Boolean).join(' ')}>
  {title && <title>{title}</title>}

  <!-- Open brackets [ ] containing the four layers (LWD-R) -->
  <g fill="currentColor">
    <!-- Left bracket -->
    <path d="M 4 4 H 9 V 6 H 6 V 26 H 9 V 28 H 4 Z" />
    <!-- Right bracket -->
    <path d="M 28 4 H 23 V 6 H 26 V 26 H 23 V 28 H 28 Z" />

    <!-- Four descending layer bars: L W D R -->
    <rect x="9.5" y="9" width="13" height="2" />
    <rect x="9.5" y="13.5" width="10" height="2" />
    <rect x="9.5" y="18" width="7" height="2" />
    <rect x="9.5" y="22.5" width="4" height="2" />
  </g>
</svg>

<style>
  .brand-svg { display: block; flex: 0 0 auto; }
</style>
