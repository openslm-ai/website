---
import BrandMark from './BrandMark.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-wide site-footer__inner">

    <div class="site-footer__brand">
      <a href="/" class="footer-brand" aria-label="openslm.ai home">
        <BrandMark size={26} class="footer-brand__svg" />
        <span class="footer-brand__name">
          <span class="footer-brand__bracket" aria-hidden="true">[</span><span class="footer-brand__open">Open</span><span class="footer-brand__core">SLM</span><span class="footer-brand__bracket" aria-hidden="true">]</span><span class="footer-brand__tld">.ai</span>
        </span>
      </a>
      <p class="footer-tagline">
        Principles for open, accessible, and correctable AI.
      </p>
    </div>

    <nav class="site-footer__col" aria-label="Read">
      <h3 class="footer-h">Read</h3>
      <ul>
        <li><a href="/accord/">The Accord</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/translations/">Translations</a></li>
        <li><a href="/downloads/accord.md" download>Markdown</a></li>
        <li><a href="/downloads/accord.pdf" download>PDF</a></li>
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Connect">
      <h3 class="footer-h">Connect</h3>
      <ul>
        <li><a href="https://github.com/openslm-ai" rel="noopener">GitHub</a></li>
        <li><a href="mailto:endorse@openslm.ai">Endorse</a></li>
        <li><a href="mailto:hello@openslm.ai">hello@openslm.ai</a></li>
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Initiative">
      <h3 class="footer-h">Initiative</h3>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/research/">Research</a></li>
        <li><a href="/version-history/">Version history</a></li>
        <li>
          <a href="https://github.com/openslm-ai/website/blob/main/CONTRIBUTING.md">
            Contribute
          </a>
        </li>
      </ul>
    </nav>

  </div>

  <div class="container-wide site-footer__meta">
    <p class="footer-licenses">
      <span>Content</span>
      <a href="https://creativecommons.org/publicdomain/zero/1.0/" rel="license">CC0&nbsp;1.0</a>
      <span class="dot" aria-hidden="true">·</span>
      <span>Code</span>
      <a href="https://opensource.org/licenses/MIT" rel="license">MIT</a>
      <span class="dot" aria-hidden="true">·</span>
      <span>©&nbsp;{year}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--color-rule);
    background: var(--color-soft);
    font-family: var(--font-sans);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    padding-block: 3.5rem 2.5rem;
  }

  @media (max-width: 880px) {
    .site-footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1.5rem;
      padding-block: 2.75rem 1.75rem;
    }
  }

  @media (max-width: 520px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* ─── Brand block ─── */
  .site-footer__brand {
    max-width: 22rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--color-fg);
  }

  .footer-brand__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    background: var(--color-fg);
    color: var(--color-bg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1;
    border-radius: 2px;
  }

  .footer-brand__name {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1;
    color: var(--color-fg);
  }

  .footer-brand__bracket {
    font-weight: 700;
    color: var(--color-accent);
    margin-inline: 0.05em;
  }

  .footer-brand__open {
    font-weight: 600;
    letter-spacing: -0.012em;
  }

  .footer-brand__core {
    font-weight: 800;
    letter-spacing: 0.005em;
  }

  .footer-brand__tld {
    font-style: italic;
    font-weight: 600;
    font-size: 0.9em;
    letter-spacing: -0.005em;
    color: var(--color-muted);
    margin-left: 0.06em;
  }

  .footer-tagline {
    margin: 0.85rem 0 0.85rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 20rem;
  }

  /* ─── Link columns ─── */
  .footer-h {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    color: var(--color-fg);
    margin: 0 0 0.85rem;
  }

  .site-footer__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .site-footer__col a {
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 80ms ease;
  }

  .site-footer__col a:hover { color: var(--color-accent); }

  /* ─── Meta strip ─── */
  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-rule);
    font-size: 0.78rem;
    color: var(--color-faint);
  }

  .footer-licenses a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .footer-licenses a:hover { color: var(--color-accent); }

  .footer-licenses {
    margin: 0;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-feature-settings: 'tnum';
  }

  .footer-licenses .dot { color: var(--color-faint); }

  @media print {
    .site-footer { display: none; }
  }
</style>
