---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-wide site-footer__inner">

    <div class="site-footer__brand">
      <a href="/" class="footer-brand" aria-label="openslm.ai home">
        <span class="footer-brand__mark" aria-hidden="true">§</span>
        <span class="footer-brand__name">openslm.ai</span>
      </a>
      <p class="footer-tagline">
        Principles for open, accessible, and correctable AI.
        Released under CC0.
      </p>
      <p class="footer-version">
        <span class="footer-version__pill">v0.1 · draft</span>
      </p>
    </div>

    <nav class="site-footer__col" aria-label="Read">
      <h3 class="footer-h">Read</h3>
      <ul>
        <li><a href="/#accord">The Accord</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/translations/">Translations</a></li>
        <li><a href="/downloads/accord.md" download>Markdown</a></li>
        <li><a href="/downloads/accord.pdf" download>PDF</a></li>
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Connect">
      <h3 class="footer-h">Connect</h3>
      <ul>
        <li><a href="https://github.com/openslm-ai" rel="noopener">GitHub</a></li>
        <li><a href="mailto:endorse@openslm.ai">Endorse</a></li>
        <li><a href="mailto:hello@openslm.ai">hello@openslm.ai</a></li>
        <li><a href="https://anivar.net/corrigibility">Corrigibility (essay)</a></li>
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Initiative">
      <h3 class="footer-h">Initiative</h3>
      <ul>
        <li><a href="/#about">About</a></li>
        <li><a href="https://anivar.net">Anivar Aravind</a></li>
        <li>
          <a href="https://github.com/openslm-ai/website/blob/main/CONTRIBUTING.md">
            Contribute
          </a>
        </li>
        <li>
          <a href="https://github.com/openslm-ai/website/blob/main/CODE_OF_CONDUCT.md">
            Code of conduct
          </a>
        </li>
      </ul>
    </nav>

  </div>

  <div class="container-wide site-footer__meta">
    <p class="footer-credit">
      Founded by <a href="https://anivar.net">Anivar Aravind</a>.
      Hosted at <a href="/">openslm.ai</a>.
    </p>
    <p class="footer-licenses">
      <span>Content</span>
      <a href="https://creativecommons.org/publicdomain/zero/1.0/" rel="license">CC0&nbsp;1.0</a>
      <span class="dot" aria-hidden="true">·</span>
      <span>Code</span>
      <a href="https://opensource.org/licenses/MIT" rel="license">MIT</a>
      <span class="dot" aria-hidden="true">·</span>
      <span>©&nbsp;{year}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--color-rule);
    background: var(--color-soft);
    font-family: var(--font-sans);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    padding-block: 3.5rem 2.5rem;
  }

  @media (max-width: 880px) {
    .site-footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1.5rem;
      padding-block: 2.75rem 1.75rem;
    }
  }

  @media (max-width: 520px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* ─── Brand block ─── */
  .site-footer__brand {
    max-width: 22rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--color-fg);
  }

  .footer-brand__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    background: var(--color-fg);
    color: var(--color-bg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1;
    border-radius: 2px;
  }

  .footer-brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.005em;
  }

  .footer-tagline {
    margin: 0.85rem 0 0.85rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 20rem;
  }

  .footer-version {
    margin: 0;
  }

  .footer-version__pill {
    display: inline-block;
    padding: 0.18rem 0.55rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 999px;
    background: var(--color-bg);
    font-feature-settings: 'tnum';
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--color-muted);
    letter-spacing: 0.02em;
  }

  /* ─── Link columns ─── */
  .footer-h {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    color: var(--color-fg);
    margin: 0 0 0.85rem;
  }

  .site-footer__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .site-footer__col a {
    color: var(--color-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 80ms ease;
  }

  .site-footer__col a:hover { color: var(--color-accent); }

  /* ─── Meta strip ─── */
  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-rule);
    font-size: 0.78rem;
    color: var(--color-faint);
  }

  .footer-credit { margin: 0; }

  .footer-credit a,
  .footer-licenses a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .footer-credit a:hover,
  .footer-licenses a:hover { color: var(--color-accent); }

  .footer-licenses {
    margin: 0;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-feature-settings: 'tnum';
  }

  .footer-licenses .dot { color: var(--color-faint); }

  @media print {
    .site-footer { display: none; }
  }
</style>
