---
interface SectionLink {
  number: number | null;
  title: string;
  anchor: string;
}
interface Props {
  sections: SectionLink[];
}
const { sections } = Astro.props;

const numbered = sections.filter((s) => s.number !== null);
const preamble = sections.find((s) => s.number === null);
---

<aside class="accord-nav hidden lg:block" aria-label="Sections" data-accord-nav>
  <h3>Contents</h3>
  <ol>
    {preamble && (
      <li class="accord-nav__pre" data-anchor={preamble.anchor}>
        <a href={`#${preamble.anchor}`}>{preamble.title}</a>
      </li>
    )}
    {numbered.map((s) => (
      <li data-anchor={s.anchor}>
        <a href={`#${s.anchor}`}>{s.title}</a>
      </li>
    ))}
  </ol>
</aside>
