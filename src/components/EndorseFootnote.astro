---
/*
 * Endorse band.
 *
 * Two parts:
 *   1. Prominent CTA card inviting endorsement (the action).
 *   2. Below, when endorsers exist, the running list — logo wall and
 *      then non-logo signatories in two columns.
 *
 * Replaces the previous quiet "footnote" treatment with a card that
 * reads as a call to action, not as auxiliary metadata. The card
 * itself is plain (no gradients) — paper, ink, indigo only.
 */
import { getCollection } from 'astro:content';

const endorsers = await getCollection('endorsers');
endorsers.sort((a, b) => {
  const oa = a.data.order ?? Number.POSITIVE_INFINITY;
  const ob = b.data.order ?? Number.POSITIVE_INFINITY;
  if (oa !== ob) return oa - ob;
  const da = a.data.date.getTime();
  const db = b.data.date.getTime();
  if (da !== db) return db - da;
  return a.data.name.localeCompare(b.data.name);
});

const typeLabel: Record<string, string> = {
  'research-institution': 'Research institution',
  'model-developer': 'Model developer',
  'infrastructure-provider': 'Infrastructure provider',
  'civil-society': 'Civil society',
  'enterprise': 'Enterprise',
  'standards-body': 'Standards body',
  'individual': 'Individual',
};

const withLogo = endorsers.filter((e) => e.data.logo);
const withoutLogo = endorsers.filter((e) => !e.data.logo);
const hasAny = endorsers.length > 0;
---

<section class="endorse-band" id="endorse" aria-labelledby="endorse-h">
  <div class="endorse-band__cta">
    <p class="endorse-band__eyebrow">Endorse</p>
    <h3 id="endorse-h" class="endorse-band__title">
      Sign on to the accord.
    </h3>
    <p class="endorse-band__body">
      Endorsement is a public commitment to the ten principles and to
      progressing on the LWD-R layers your work touches. Signatories
      include research institutions, model developers, infrastructure
      providers, civil society organizations, enterprises, and standards
      bodies.
    </p>
    <div class="endorse-band__actions">
      <a href="mailto:endorse@openslm.ai" class="btn btn--primary">Write to endorse@openslm.ai</a>
      <a href="/faq/#endorsement" class="btn btn--ghost">What endorsement means</a>
    </div>
  </div>

  {hasAny && (
    <div class="endorse-band__roll" aria-label="Current endorsers">
      <p class="endorse-band__roll-label">Endorsed by</p>

      {withLogo.length > 0 && (
        <ul class="logo-wall" role="list">
          {withLogo.map((e) => (
            <li>
              {e.data.url ? (
                <a href={e.data.url} title={e.data.name} rel="noopener">
                  <img src={e.data.logo} alt={e.data.name} loading="lazy" decoding="async" />
                </a>
              ) : (
                <img src={e.data.logo} alt={e.data.name} loading="lazy" decoding="async" />
              )}
            </li>
          ))}
        </ul>
      )}

      {withoutLogo.length > 0 && (
        <ul class="signatory-list" role="list">
          {withoutLogo.map((e) => (
            <li>
              {e.data.url ? <a href={e.data.url} rel="noopener">{e.data.name}</a> : e.data.name}
              <span class="meta"> · {typeLabel[e.data.type]}{e.data.country ? `, ${e.data.country}` : ''}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  )}
</section>

<style>
  .endorse-band {
    margin-top: 4.5rem;
    padding: 2.25rem 0 0;
    border-top: 1px solid var(--color-rule);
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    scroll-margin-top: 4rem;
  }

  .endorse-band__cta {
    border: 1px solid var(--color-rule-strong);
    padding: 1.75rem 1.75rem 2rem;
    background: var(--color-soft);
  }

  .endorse-band__eyebrow {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 700;
    color: var(--color-accent);
    margin: 0 0 0.85rem;
  }

  .endorse-band__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    line-height: 1.15;
    letter-spacing: -0.005em;
    color: var(--color-heading);
    margin: 0 0 1rem;
    text-wrap: balance;
  }

  .endorse-band__body {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-fg);
    max-width: 38rem;
    margin: 0 0 1.5rem;
    text-wrap: pretty;
  }

  .endorse-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .endorse-band__roll {
    padding-top: 0.5rem;
  }

  .endorse-band__roll-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-faint);
    margin: 0 0 1.25rem;
  }

  .logo-wall {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 1.75rem 2rem;
    align-items: center;
  }

  .logo-wall li {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
  }

  .logo-wall img {
    max-width: 100%;
    max-height: 2.5rem;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.75;
    transition: filter 120ms ease, opacity 120ms ease;
  }

  .logo-wall a:hover img,
  .logo-wall a:focus-visible img {
    filter: grayscale(0);
    opacity: 1;
  }

  .signatory-list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 2.5rem;
  }

  @media (max-width: 40rem) {
    .signatory-list { columns: 1; }
  }

  .signatory-list li {
    margin: 0 0 0.5rem;
    break-inside: avoid;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .signatory-list .meta {
    color: var(--color-faint);
    font-size: 0.8125rem;
  }

  @media print {
    .endorse-band__cta {
      background: #fff;
      border-color: #000;
    }
    .endorse-band { color: #000; }
    .logo-wall img { filter: none; opacity: 1; }
  }
</style>
