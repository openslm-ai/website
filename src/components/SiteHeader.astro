---
const links = [
  { href: '/#accord', label: 'Accord' },
  { href: '/#research', label: 'Research' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/translations/', label: 'Translations' },
  { href: '/#about', label: 'About' },
];
---

<header class="site-header">
  <div class="container-wide site-header__inner">
    <a href="/" class="site-header__brand" aria-label="openslm.ai home">
      <span class="brand-mark" aria-hidden="true">§</span>
      <span class="brand-stack">
        <span class="brand-name">openslm.ai</span>
        <span class="brand-tag">Open Small Models Accord</span>
      </span>
    </a>

    <nav aria-label="Primary" class="site-header__nav">
      <ul class="site-header__links">
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>

      <span class="version-pill" title="Accord version 0.1, draft">
        <span class="version-pill__num">v0.1</span>
        <span class="version-pill__sep" aria-hidden="true">·</span>
        <span class="version-pill__state">draft</span>
      </span>

      <a
        href="https://github.com/openslm-ai"
        class="site-header__gh"
        aria-label="openslm-ai on GitHub"
        rel="noopener">
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8a8.013 8.013 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--color-rule);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding-block: 0.95rem;
  }

  /* ─── Brand ─── */
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--color-fg);
    line-height: 1;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1.5px solid var(--color-fg);
    background: var(--color-fg);
    color: var(--color-bg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1;
    border-radius: 2px;
    transition: background 120ms ease, color 120ms ease, border-color 120ms ease;
  }

  .site-header__brand:hover .brand-mark {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .brand-stack {
    display: inline-flex;
    flex-direction: column;
    gap: 0.18rem;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--color-fg);
  }

  .brand-tag {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--color-faint);
  }

  /* ─── Nav ─── */
  .site-header__nav {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }

  .site-header__links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.875rem;
  }

  .site-header__links a {
    color: var(--color-muted);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.005em;
    transition: color 80ms ease;
    position: relative;
  }

  .site-header__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 140ms ease;
  }

  .site-header__links a:hover,
  .site-header__links a:focus-visible {
    color: var(--color-fg);
  }

  .site-header__links a:hover::after,
  .site-header__links a:focus-visible::after {
    transform: scaleX(1);
  }

  /* ─── Version pill ─── */
  .version-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.18rem 0.55rem;
    border: 1px solid var(--color-rule-strong);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-feature-settings: 'tnum';
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--color-muted);
    line-height: 1.4;
    white-space: nowrap;
  }

  .version-pill__num {
    color: var(--color-fg);
  }

  .version-pill__sep {
    color: var(--color-faint);
  }

  .version-pill__state {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }

  /* ─── GitHub icon ─── */
  .site-header__gh {
    display: inline-flex;
    align-items: center;
    color: var(--color-muted);
    transition: color 80ms ease;
  }

  .site-header__gh:hover { color: var(--color-fg); }
  .site-header__gh svg { display: block; }

  /* ─── Mobile ─── */
  @media (max-width: 720px) {
    .site-header__inner { padding-block: 0.85rem; gap: 0.85rem 1.2rem; }
    .brand-tag { display: none; }
    .site-header__links { gap: 0.95rem; font-size: 0.82rem; }
    .version-pill { display: none; }
  }

  @media print {
    .site-header { display: none; }
  }
</style>
