---
import BrandMark from './BrandMark.astro';

const links = [
  { href: '/accord/', label: 'Accord' },
  { href: '/research/', label: 'Research' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/translations/', label: 'Translations' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="container-wide site-header__inner">
    <a href="/" class="site-header__brand" aria-label="OpenSLM.ai home">
      <BrandMark size={28} class="brand-mark-svg" />
      <span class="brand-name">
        <span class="brand-name__bracket" aria-hidden="true">[</span><span class="brand-name__open">Open</span><span class="brand-name__core">SLM</span><span class="brand-name__bracket" aria-hidden="true">]</span><span class="brand-name__tld">.ai</span>
      </span>
    </a>

    <nav aria-label="Primary" class="site-header__nav">
      <ul class="site-header__links">
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>

      <button
        type="button"
        class="site-header__theme"
        data-theme-toggle
        aria-label="Toggle dark mode"
        title="Toggle dark mode">
        <svg class="theme-icon theme-icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="theme-icon theme-icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a
        href="https://github.com/openslm-ai"
        class="site-header__gh"
        aria-label="openslm-ai on GitHub"
        rel="noopener">
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8a8.013 8.013 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector('[data-theme-toggle]');
    if (!btn) return;
    var media = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;

    function current() {
      var explicit = document.documentElement.getAttribute('data-theme');
      if (explicit === 'light' || explicit === 'dark') return explicit;
      return media && media.matches ? 'dark' : 'light';
    }

    function reflect() {
      var t = current();
      btn.setAttribute('aria-pressed', t === 'dark' ? 'true' : 'false');
      btn.setAttribute('title', t === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
      btn.setAttribute('aria-label', t === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
    }

    btn.addEventListener('click', function () {
      var next = current() === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (_) {}
      reflect();
    });

    if (media && media.addEventListener) {
      media.addEventListener('change', function () {
        if (!document.documentElement.hasAttribute('data-theme')) reflect();
      });
    }

    reflect();
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--color-rule);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding-block: 0.95rem;
  }

  /* ─── Brand ─── */
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--color-fg);
    line-height: 1;
  }

  :global(.brand-mark-svg) {
    color: var(--color-fg);
    transition: color 120ms ease, transform 120ms ease;
    flex: 0 0 auto;
  }

  .site-header__brand:hover :global(.brand-mark-svg) {
    color: var(--color-accent);
  }

  .brand-name {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: 1.18rem;
    line-height: 1;
    color: var(--color-heading);
  }

  .brand-name__bracket {
    font-weight: 700;
    color: var(--color-accent);
    margin-inline: 0.05em;
    transform: translateY(0.02em);
    transition: color 120ms ease;
  }

  .brand-name__open {
    font-weight: 600;
    letter-spacing: -0.012em;
  }

  .brand-name__core {
    font-weight: 800;
    letter-spacing: 0.005em;
    color: var(--color-fg);
  }

  .brand-name__tld {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 0.9em;
    letter-spacing: -0.005em;
    color: var(--color-muted);
    margin-left: 0.06em;
    transition: color 120ms ease;
  }

  .site-header__brand:hover .brand-name { color: var(--color-fg); }
  .site-header__brand:hover .brand-name__bracket { color: var(--color-accent-hover); }
  .site-header__brand:hover .brand-name__tld { color: var(--color-accent); }

  /* ─── Nav ─── */
  .site-header__nav {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }

  .site-header__links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.875rem;
  }

  .site-header__links a {
    color: var(--color-muted);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.005em;
    transition: color 80ms ease;
    position: relative;
  }

  .site-header__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35rem;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 140ms ease;
  }

  .site-header__links a:hover,
  .site-header__links a:focus-visible {
    color: var(--color-fg);
  }

  .site-header__links a:hover::after,
  .site-header__links a:focus-visible::after {
    transform: scaleX(1);
  }

  /* ─── GitHub icon ─── */
  .site-header__gh {
    display: inline-flex;
    align-items: center;
    color: var(--color-muted);
    transition: color 80ms ease;
  }

  .site-header__gh:hover { color: var(--color-fg); }
  .site-header__gh svg { display: block; }

  /* ─── Theme toggle ─── */
  .site-header__theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 100ms ease, border-color 100ms ease, background 100ms ease;
  }

  .site-header__theme:hover,
  .site-header__theme:focus-visible {
    color: var(--color-fg);
    border-color: var(--color-rule-strong);
    background: var(--color-soft);
    outline: none;
  }

  .site-header__theme:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Icon visibility is theme-conditional and lives in global.css
     (Astro scoped styles cannot reach :root[data-theme]). */
  .theme-icon { display: none; }
  .theme-icon--moon { display: block; }

  /* ─── Mobile ─── */
  @media (max-width: 720px) {
    .site-header__inner { padding-block: 0.85rem; gap: 0.85rem 1.2rem; }
    .site-header__links { gap: 0.95rem; font-size: 0.82rem; }
  }

  @media print {
    .site-header { display: none; }
  }
</style>
