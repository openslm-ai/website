---
const links = [
  { href: '#accord', label: 'Accord' },
  { href: '#code', label: 'Code' },
  { href: '#research', label: 'Research' },
  { href: '#references', label: 'References' },
  { href: '#about', label: 'About' },
];
---

<header class="border-b border-[color:var(--color-rule)]">
  <div class="container-wide flex flex-wrap items-baseline justify-between gap-4 py-5">
    <a
      href="#top"
      class="brand no-underline text-[color:var(--color-fg)]"
      aria-label="openslm.ai home">openslm.ai</a>
    <nav aria-label="Primary">
      <ul class="m-0 flex list-none flex-wrap gap-5 p-0 text-sm">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="no-underline text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)]">
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href="https://github.com/openslm-ai"
            class="no-underline text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)]">
            GitHub
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
