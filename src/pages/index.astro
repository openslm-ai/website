---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AccordNav from '../components/AccordNav.astro';
import EndorseFootnote from '../components/EndorseFootnote.astro';

const accordEntries = await getCollection('accord');
accordEntries.sort((a, b) => a.data.order - b.data.order);

const sections = accordEntries.map((e) => ({
  number: e.data.number,
  title: e.data.title,
  anchor: e.data.anchor,
}));

const renderedAccord = await Promise.all(
  accordEntries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

const pad2 = (n: number) => n.toString().padStart(2, '0');
---

<BaseLayout
  description="The Open Small Models Accord — principles for open, accessible, and correctable AI. Hosted at openslm.ai."
  ogType="article">

  <!-- ─── Hero / framing ─── -->
  <section id="top" class="hero">
    <div class="container-page hero__inner">
      <p class="hero__meta">
        <span class="hero__pill"><span class="hero__pill-num">v0.1</span> · Draft</span>
        <span class="hero__dot" aria-hidden="true">·</span>
        <time datetime="2026-04-06">Issued 6 April 2026</time>
        <span class="hero__dot" aria-hidden="true">·</span>
        <a href="/version-history/" class="hero__history">Version history</a>
      </p>

      <h1 class="hero__title">The Open Small<br />Models Accord</h1>
      <p class="hero__subtitle">
        On open, accessible, and correctable AI for the next decade.
      </p>

      <p class="hero__lede">
        openslm.ai is the home for the accord and related work on open,
        accessible, and correctable AI. We document principles, build tooling,
        and publish research aimed at making small language models genuinely
        open: inspectable, reproducible, and correctable by the people they
        affect.
      </p>

      <div class="hero__actions">
        <a href="#accord" class="btn btn--primary">Read the accord</a>
        <a href="/downloads/accord.md" download class="btn btn--ghost">Markdown</a>
        <a href="/downloads/accord.pdf" download class="btn btn--ghost">PDF</a>
      </div>

      <ul class="hero__layers" aria-label="The four layers (LWD-R)">
        <li><span class="hero__layer-mark">L</span><span>Logic</span></li>
        <li><span class="hero__layer-mark">W</span><span>Weights</span></li>
        <li><span class="hero__layer-mark">D</span><span>Data</span></li>
        <li><span class="hero__layer-mark">R</span><span>Representation</span></li>
      </ul>
    </div>
  </section>

  <div class="section-mark" aria-hidden="true">§</div>

  <!-- ─── Accord ─── -->
  <section id="accord" class="container-wide py-14 md:py-20">
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-[15rem_minmax(0,40rem)] lg:gap-20">
      <div class="lg:sticky lg:top-8 lg:self-start lg:max-h-[calc(100vh-4rem)] lg:overflow-y-auto">
        <AccordNav sections={sections} />
      </div>

      <div>
        <details class="mb-8 lg:hidden">
          <summary class="jump">Jump to section</summary>
          <ol class="mt-4 ml-0 pl-0 list-none text-sm leading-snug">
            {sections.filter((s) => s.number !== null).map((s) => (
              <li class="mb-2 grid grid-cols-[1.75rem_1fr] gap-1">
                <span class="text-[color:var(--color-faint)] font-bold" style="font-family: var(--font-display); font-feature-settings: 'tnum';">
                  {pad2(s.number!)}
                </span>
                <a href={`#${s.anchor}`}>{s.title}</a>
              </li>
            ))}
          </ol>
        </details>

        <div class="accord-body">
          <div class="accord-stamp" aria-label="Document metadata">
            <span class="accord-stamp__row">
              <span class="accord-stamp__k">Version</span>
              <span class="accord-stamp__v">0.1 (draft)</span>
            </span>
            <span class="accord-stamp__row">
              <span class="accord-stamp__k">Issued</span>
              <span class="accord-stamp__v">
                <time datetime="2026-04-06">6 April 2026</time>
              </span>
            </span>
            <span class="accord-stamp__row">
              <span class="accord-stamp__k">License</span>
              <span class="accord-stamp__v">
                <a href="https://creativecommons.org/publicdomain/zero/1.0/" rel="license">CC0&nbsp;1.0</a>
              </span>
            </span>
            <p class="accord-stamp__note">
              The accord is a dated document. Its claims about openness are stated as
              of the issue date.
            </p>
          </div>

          {renderedAccord.map(({ entry, Content }) => {
            const { number, title, anchor } = entry.data;
            const isPreamble = number === null;
            return (
              <section id={anchor} class:list={['accord-section', { preamble: isPreamble }]}>
                {!isPreamble && (
                  <span class="section-num">§ {pad2(number!)}</span>
                )}
                <h2>
                  <a href={`#${anchor}`} class="anchor">{title}</a>
                </h2>
                <Content />
              </section>
            );
          })}

          <EndorseFootnote />

          <div class="closing">
            <p><em>Released under CC0. Translate, adapt, republish. Endorse by signing. Build according to the principles.</em></p>
          </div>

          <aside class="attribution" id="attribution" aria-label="Attribution">
            <h3>Attribution</h3>
            <p>
              The Open Small Models Accord, version 0.1 (draft), issued
              <time datetime="2026-04-06">6 April 2026</time>, authored by
              <a href="https://anivar.net">Anivar Aravind</a>. Hosted at
              <a href="/">openslm.ai</a>. Released under
              <a href="https://creativecommons.org/publicdomain/zero/1.0/" rel="license">CC0&nbsp;1.0</a>.
            </p>
            <p>
              The accord is a dated document. Its claims about openness are stated as
              of the issue date. Subsequent versions update the snapshot.
            </p>
            <p>
              For answers to common questions, see the <a href="/faq/">FAQ</a>.
              Translations are listed at <a href="/translations/">/translations</a>.
            </p>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <div class="section-mark" aria-hidden="true">§</div>

  <!-- ─── Research ─── -->
  <section id="research" class="tail-section">
    <div class="container-page tail-section__inner">
      <header class="tail-head">
        <span class="tail-head__rule" aria-hidden="true"></span>
        <p class="tail-head__eyebrow">Research</p>
        <h2 class="tail-head__title">Theoretical and analytical work</h2>
        <p class="tail-head__lede">
          The accord rests on a body of theoretical work on corrigibility, action
          boundaries, and evaluation methodology. Forthcoming papers will be published
          with reproducible artifacts and linked here.
        </p>
      </header>

      <article class="tail-card">
        <h3 class="tail-card__title">Corrigibility framework</h3>
        <p class="tail-card__body">
          A structural framework for evaluating whether digital and AI-mediated public
          infrastructure permits correction by affected participants. The framework
          comprises two preprints, evaluated against five tests: EXIT, CODE, AUDIT,
          GOVERN, and FORK.
        </p>
        <p class="tail-card__meta">
          <a href="https://anivar.net/corrigibility">anivar.net/corrigibility</a>
        </p>
      </article>

      <article class="tail-card">
        <h3 class="tail-card__title">Paper I · DPI</h3>
        <p class="tail-card__body">
          <strong>Corrigibility as a Structural Precondition for Digital Public
          Infrastructure.</strong> Examines corrigibility requirements for deterministic
          systems (ledgers, registries, payment rails) and how structural safeguards let
          affected parties detect errors and hold infrastructure accountable.
          <em>DPI = Deterministic Public Infrastructure.</em>
        </p>
        <p class="tail-card__meta">
          <span class="tail-status">Preprint</span>
          <a href="https://anivar.net/corrigibility">anivar.net/corrigibility</a>
        </p>
      </article>

      <article class="tail-card">
        <h3 class="tail-card__title">Paper II · EPI</h3>
        <p class="tail-card__body">
          <strong>Epistemic Capture and the Action Boundary.</strong> Extends the
          framework to learned and agentic systems, examining how epistemic constraints
          shape decision boundaries in AI and machine learning infrastructure.
          <em>EPI = Epistemic Public Infrastructure.</em>
        </p>
        <p class="tail-card__meta">
          <span class="tail-status">Preprint</span>
          <a href="https://anivar.net/corrigibility">anivar.net/corrigibility</a>
        </p>
      </article>

      <article class="tail-card">
        <h3 class="tail-card__title">Related directions</h3>
        <p class="tail-card__body">
          The accord draws on the OSI Open Source AI Definition (§2 in particular),
          Princeton's research on AI agent reliability, and the emerging Agentic Skills
          specification work on composable, inspectable agent capabilities.
        </p>
      </article>
    </div>
  </section>

  <div class="section-mark" aria-hidden="true">§</div>

  <!-- ─── About ─── -->
  <section id="about" class="tail-section">
    <div class="container-page tail-section__inner">
      <header class="tail-head">
        <span class="tail-head__rule" aria-hidden="true"></span>
        <p class="tail-head__eyebrow">About</p>
        <h2 class="tail-head__title">About this initiative</h2>
        <p class="tail-head__lede">
          openslm.ai is an initiative to make small language models, and the systems
          that run them, open in a way that holds up: inspectable, reproducible, and
          correctable by the people they affect.
        </p>
      </header>

      <p class="tail-paragraph">
        The initiative is founded and initiated by
        <a href="https://anivar.net">Anivar Aravind</a>, a longtime contributor to free
        software, language technology, and digital rights, with a focus on open
        infrastructure for non-English-speaking users.
      </p>

      <div class="contact-grid">
        <div class="contact-card">
          <h4>General inquiries</h4>
          <a href="mailto:hello@openslm.ai">hello@openslm.ai</a>
        </div>
        <div class="contact-card">
          <h4>Endorsement</h4>
          <a href="mailto:endorse@openslm.ai">endorse@openslm.ai</a>
        </div>
        <div class="contact-card">
          <h4>Code and issues</h4>
          <a href="https://github.com/openslm-ai">github.com/openslm-ai</a>
        </div>
      </div>

      <h3 class="involve-h">Get involved</h3>
      <ul class="involve-list">
        <li>
          Open an issue or pull request on
          <a href="https://github.com/openslm-ai">github.com/openslm-ai</a>.
        </li>
        <li>
          Send a note to <a href="mailto:hello@openslm.ai">hello@openslm.ai</a> to
          discuss the accord, contribute code, or work on the research.
        </li>
        <li>
          Endorse the accord once endorsement opens after the first wave of
          conversations.
        </li>
      </ul>
    </div>
  </section>

</BaseLayout>
