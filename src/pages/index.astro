---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const accordEntries = await getCollection('accord');
const principles = accordEntries
  .filter((e) => e.data.number !== null)
  .sort((a, b) => a.data.order - b.data.order);

const pad2 = (n: number) => n.toString().padStart(2, '0');
---

<BaseLayout
  description="OpenSLM.ai — an initiative for open, accessible, and correctable small language models. Home of the Open Small Models Accord.">

  <section class="hero hero--home">
    <div class="container-page hero__inner">
      <h1 class="hero__title">Open, accessible,<br />correctable AI.</h1>
      <p class="hero__subtitle">
        For the next decade of small language models.
      </p>

      <p class="hero__lede">
        OpenSLM.ai is the home for the
        <a href="/accord/">Open Small Models Accord</a> and related work on open,
        accessible, and correctable AI. We document principles, build tooling, and
        publish research aimed at making small language models genuinely open:
        inspectable, reproducible, and correctable by the people they affect.
      </p>

      <div class="hero__actions">
        <a href="/accord/" class="btn btn--primary">Read the accord</a>
        <a href="/research/" class="btn btn--ghost">Research</a>
      </div>

      <a href="/research/#lwd-r" class="hero__layers-link" aria-label="LWD-R: the four layers, explained">
        <ul class="hero__layers" aria-label="The four layers (LWD-R)">
          <li><span class="hero__layer-mark">L</span><span>Logic</span></li>
          <li><span class="hero__layer-mark">W</span><span>Weights</span></li>
          <li><span class="hero__layer-mark">D</span><span>Data</span></li>
          <li><span class="hero__layer-mark">R</span><span>Representation</span></li>
        </ul>
      </a>
    </div>
  </section>

  <div class="section-mark" aria-hidden="true">§</div>

  <section id="principles" class="principles">
    <div class="container-page principles__inner">
      <header class="principles__head">
        <span class="tail-head__rule" aria-hidden="true"></span>
        <p class="tail-head__eyebrow">The principles</p>
        <h2 class="tail-head__title">Ten principles for open, small AI.</h2>
        <p class="tail-head__lede">
          The accord names ten principles. Read each as a single idea, then
          <a href="/accord/">read the full text</a> for the argument behind it.
        </p>
      </header>

      <ol class="principles__list" aria-label="The ten principles">
        {principles.map((p) => (
          <li class="principle">
            <a href={`/accord/#${p.data.anchor}`} class="principle__link">
              <span class="principle__folio" aria-hidden="true">
                <span class="principle__sym">§</span><span class="principle__num">{pad2(p.data.number!)}</span>
              </span>
              <h3 class="principle__title">{p.data.title}</h3>
              <span class="principle__cta" aria-hidden="true">
                <span class="principle__cta-text">Read</span>
                <span class="principle__cta-arrow">&rarr;</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <div class="section-mark" aria-hidden="true">§</div>

  <section class="tail-section">
    <div class="container-page tail-section__inner">
      <header class="tail-head">
        <span class="tail-head__rule" aria-hidden="true"></span>
        <p class="tail-head__eyebrow">Initiative</p>
        <h2 class="tail-head__title">Built in the open.</h2>
        <p class="tail-head__lede">
          OpenSLM.ai will evolve. The accord is the founding artifact, but the
          initiative reaches further &mdash; into tooling, evaluation, and infrastructure
          for small models that can be inspected, reproduced, and corrected.
        </p>
      </header>

      <div class="link-rail">
        <a href="/about/" class="link-rail__item">
          <span class="link-rail__k">About</span>
          <span class="link-rail__v">The initiative and its founder.</span>
        </a>
        <a href="/version-history/" class="link-rail__item">
          <span class="link-rail__k">Version history</span>
          <span class="link-rail__v">Each accord version as a public artifact.</span>
        </a>
        <a href="https://github.com/openslm-ai" class="link-rail__item">
          <span class="link-rail__k">GitHub</span>
          <span class="link-rail__v">Code, issues, contributions.</span>
        </a>
        <a href="mailto:hello@openslm.ai" class="link-rail__item">
          <span class="link-rail__k">Contact</span>
          <span class="link-rail__v">hello@openslm.ai</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .principles {
    padding-block: 4rem 5rem;
    background: var(--color-bg);
  }

  @media (min-width: 768px) {
    .principles { padding-block: 5.5rem 6.5rem; }
  }

  .principles__head {
    max-width: 44rem;
    margin: 0 0 3.5rem;
  }

  @media (min-width: 768px) {
    .principles__head { margin-bottom: 4.5rem; }
  }

  .principles__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 3rem;
    row-gap: 0;
    border-top: 1px solid var(--color-rule-strong);
  }

  @media (min-width: 720px) {
    .principles__list {
      grid-template-columns: 1fr 1fr;
      column-gap: 4rem;
    }
  }

  .principle {
    border-bottom: 1px solid var(--color-rule);
    position: relative;
  }

  /* Remove bottom rule on the last row (last 2 items at 2-col) */
  @media (min-width: 720px) {
    .principle:nth-last-child(-n+2) { border-bottom: 0; }
  }

  .principle__link {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 2.25rem 0 2.5rem;
    text-decoration: none;
    color: var(--color-fg);
    position: relative;
    height: 100%;
  }

  @media (min-width: 768px) {
    .principle__link {
      gap: 1.35rem;
      padding: 2.75rem 0 3rem;
    }
  }

  /* A subtle indigo accent rule that grows from the top-left on hover */
  .principle__link::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .principle__link:hover::before,
  .principle__link:focus-visible::before {
    width: 4rem;
  }

  /* Folio: § (small, above the number's cap line) + 01 (very large) */
  .principle__folio {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.18em;
    font-family: var(--font-display);
    font-feature-settings: 'tnum';
    line-height: 0.85;
    color: var(--color-accent);
    transition: color 200ms ease;
  }

  .principle__sym {
    font-weight: 600;
    font-size: clamp(0.95rem, 1.1vw, 1.1rem);
    line-height: 1;
    color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    margin-top: 0.3em;
    transition: color 200ms ease;
  }

  .principle__num {
    font-weight: 800;
    font-size: clamp(3rem, 5vw, 4.25rem);
    letter-spacing: -0.03em;
  }

  .principle__title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    line-height: 1.35;
    text-wrap: balance;
    color: var(--color-fg);
    flex: 1;
  }

  .principle__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-faint);
    transition: color 200ms ease;
  }

  .principle__cta-arrow {
    display: inline-block;
    transform: translateX(0);
    transition: transform 200ms ease;
  }

  /* Hover: folio brightens, title underlines, arrow advances */
  .principle__link:hover .principle__folio,
  .principle__link:focus-visible .principle__folio {
    color: var(--color-accent);
  }

  .principle__link:hover .principle__sym,
  .principle__link:focus-visible .principle__sym {
    color: var(--color-accent);
  }

  .principle__link:hover .principle__title,
  .principle__link:focus-visible .principle__title {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 60%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
  }

  .principle__link:hover .principle__cta,
  .principle__link:focus-visible .principle__cta {
    color: var(--color-accent);
  }

  .principle__link:hover .principle__cta-arrow,
  .principle__link:focus-visible .principle__cta-arrow {
    transform: translateX(0.35rem);
  }

  .principle__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>
