---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const accordEntries = await getCollection('accord');
const principles = accordEntries
  .filter((e) => e.data.number !== null)
  .sort((a, b) => a.data.order - b.data.order);

const pad2 = (n: number) => n.toString().padStart(2, '0');
---

<BaseLayout
  description="OpenSLM.ai — an initiative for open, accessible, and correctable small language models. Home of the Open Small Models Accord.">

  <section class="hero hero--home">
    <div class="container-page hero__inner">
      <h1 class="hero__title">Open, accessible,<br />correctable AI.</h1>
      <p class="hero__subtitle">
        For the next decade of small language models.
      </p>

      <p class="hero__lede">
        OpenSLM.ai is the home for the
        <a href="/accord/">Open Small Models Accord</a> and related work on open,
        accessible, and correctable AI. We document principles, build tooling, and
        publish research aimed at making small language models genuinely open:
        inspectable, reproducible, and correctable by the people they affect.
      </p>

      <div class="hero__actions">
        <a href="/accord/" class="btn btn--primary">Read the accord</a>
        <a href="/research/" class="btn btn--ghost">Research</a>
      </div>

      <a href="/research/#lwd-r" class="hero__layers-link" aria-label="LWD-R: the four layers, explained">
        <ul class="hero__layers" aria-label="The four layers (LWD-R)">
          <li><span class="hero__layer-mark">L</span><span>Logic</span></li>
          <li><span class="hero__layer-mark">W</span><span>Weights</span></li>
          <li><span class="hero__layer-mark">D</span><span>Data</span></li>
          <li><span class="hero__layer-mark">R</span><span>Representation</span></li>
        </ul>
      </a>
    </div>
  </section>

  <div class="section-mark" aria-hidden="true">§</div>

  <section id="principles" class="principles">
    <div class="container-page principles__inner">
      <header class="principles__head">
        <span class="tail-head__rule" aria-hidden="true"></span>
        <p class="tail-head__eyebrow">The principles</p>
        <h2 class="tail-head__title">Ten principles for open, small AI.</h2>
        <p class="tail-head__lede">
          The accord names ten principles. Read each as a single idea, then
          <a href="/accord/">read the full text</a> for the argument behind it.
        </p>
      </header>

      <ol class="principles__list" aria-label="The ten principles">
        {principles.map((p) => (
          <li class="principle">
            <a href={`/accord/#${p.data.anchor}`} class="principle__link">
              <span class="principle__num" aria-hidden="true">§ {pad2(p.data.number!)}</span>
              <h3 class="principle__title">{p.data.title}</h3>
              <span class="principle__cta" aria-hidden="true">Read &rarr;</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <div class="section-mark" aria-hidden="true">§</div>

  <section class="hub">
    <div class="container-page hub__inner">
      <a href="/accord/" class="hub-card hub-card--feature">
        <span class="hub-card__num">§ 01</span>
        <h2 class="hub-card__title">The Accord</h2>
        <p class="hub-card__body">
          A standards-document on what open means for small language models in 2026:
          inspectable architectures, accessible weights, documented data, correctable
          representations.
        </p>
        <span class="hub-card__cta">Read the accord &rarr;</span>
      </a>

      <a href="/research/" class="hub-card">
        <span class="hub-card__num">§ 02</span>
        <h2 class="hub-card__title">Research</h2>
        <p class="hub-card__body">
          The corrigibility framework — DPI and EPI preprints, evaluated against
          five tests: EXIT, CODE, AUDIT, GOVERN, FORK.
        </p>
        <span class="hub-card__cta">See papers &rarr;</span>
      </a>

      <a href="/faq/" class="hub-card">
        <span class="hub-card__num">§ 03</span>
        <h2 class="hub-card__title">FAQ</h2>
        <p class="hub-card__body">
          Common questions on scope, definitions, why small models, and how the
          accord relates to existing open-source AI definitions.
        </p>
        <span class="hub-card__cta">Read the FAQ &rarr;</span>
      </a>

      <a href="/translations/" class="hub-card">
        <span class="hub-card__num">§ 04</span>
        <h2 class="hub-card__title">Translations</h2>
        <p class="hub-card__body">
          Community-led translations of the accord. Add yours by sending a pull
          request — the canonical text remains the English version.
        </p>
        <span class="hub-card__cta">All translations &rarr;</span>
      </a>
    </div>
  </section>

  <div class="section-mark" aria-hidden="true">§</div>

  <section class="tail-section">
    <div class="container-page tail-section__inner">
      <header class="tail-head">
        <span class="tail-head__rule" aria-hidden="true"></span>
        <p class="tail-head__eyebrow">Initiative</p>
        <h2 class="tail-head__title">Built in the open.</h2>
        <p class="tail-head__lede">
          OpenSLM.ai will evolve. The accord is the founding artifact, but the
          initiative reaches further &mdash; into tooling, evaluation, and infrastructure
          for small models that can be inspected, reproduced, and corrected.
        </p>
      </header>

      <div class="link-rail">
        <a href="/about/" class="link-rail__item">
          <span class="link-rail__k">About</span>
          <span class="link-rail__v">The initiative and its founder.</span>
        </a>
        <a href="/version-history/" class="link-rail__item">
          <span class="link-rail__k">Version history</span>
          <span class="link-rail__v">Each accord version as a public artifact.</span>
        </a>
        <a href="https://github.com/openslm-ai" class="link-rail__item">
          <span class="link-rail__k">GitHub</span>
          <span class="link-rail__v">Code, issues, contributions.</span>
        </a>
        <a href="mailto:hello@openslm.ai" class="link-rail__item">
          <span class="link-rail__k">Contact</span>
          <span class="link-rail__v">hello@openslm.ai</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .principles {
    padding-block: 4rem 5rem;
  }

  @media (min-width: 768px) {
    .principles { padding-block: 5rem 6rem; }
  }

  .principles__head {
    max-width: 42rem;
    margin: 0 0 3rem;
  }

  .principles__list {
    list-style: none;
    counter-reset: principle;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--color-rule);
  }

  @media (min-width: 720px) {
    .principles__list {
      grid-template-columns: 1fr 1fr;
      border-left: 1px solid var(--color-rule);
    }
  }

  .principle {
    counter-increment: principle;
    border-bottom: 1px solid var(--color-rule);
  }

  @media (min-width: 720px) {
    .principle {
      border-right: 1px solid var(--color-rule);
    }
  }

  .principle__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1.4rem 1.25rem;
    text-decoration: none;
    color: var(--color-fg);
    transition: background 100ms ease;
    min-height: 100%;
  }

  .principle__link:hover,
  .principle__link:focus-visible {
    background: color-mix(in srgb, var(--color-accent) 5%, transparent);
    outline: none;
  }

  .principle__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-accent);
    font-feature-settings: 'tnum';
    letter-spacing: 0.02em;
    white-space: nowrap;
    align-self: start;
    margin-top: 0.25rem;
  }

  .principle__title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.02rem;
    line-height: 1.45;
    margin: 0;
    text-wrap: balance;
    color: var(--color-fg);
  }

  .principle__cta {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-faint);
    align-self: start;
    margin-top: 0.5rem;
    opacity: 0;
    transition: opacity 120ms ease, color 120ms ease;
  }

  .principle__link:hover .principle__cta,
  .principle__link:focus-visible .principle__cta {
    opacity: 1;
    color: var(--color-accent);
  }

  @media (max-width: 720px) {
    .principle__cta { display: none; }
  }
</style>
