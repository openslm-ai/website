---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AccordNav from '../components/AccordNav.astro';

const accordEntries = await getCollection('accord');
accordEntries.sort((a, b) => a.data.order - b.data.order);

const sections = accordEntries.map((e) => ({
  number: e.data.number,
  title: e.data.title,
  anchor: e.data.anchor,
}));

const renderedAccord = await Promise.all(
  accordEntries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

const refs = await getCollection('references');
const refTypeOrder: Record<string, number> = {
  standard: 1,
  specification: 2,
  paper: 3,
  organization: 4,
  article: 5,
};
refs.sort((a, b) => {
  const ta = refTypeOrder[a.data.type] ?? 99;
  const tb = refTypeOrder[b.data.type] ?? 99;
  if (ta !== tb) return ta - tb;
  return a.data.title.localeCompare(b.data.title);
});

const pad2 = (n: number) => n.toString().padStart(2, '0');
---

<BaseLayout
  description="The Open Small Models Accord — principles for open, accessible, and correctable AI. Hosted at openslm.ai."
  ogType="article">

  <!-- ─── Hero / framing ─── -->
  <section id="top" class="container-page py-14 md:py-20">
    <p class="eyebrow">openslm.ai · Open Small Models Accord · v0.1 draft</p>
    <h1 class="display-xl mb-4">The Open Small Models Accord</h1>
    <p class="subtitle-xl">On open, accessible, and correctable AI for the next decade.</p>

    <p class="lede mt-8">
      openslm.ai is the home for the Open Small Models Accord and related work on open,
      accessible, and correctable AI. We document principles, build tooling, and publish
      research aimed at making small language models genuinely open — inspectable,
      reproducible, and correctable by the people they affect.
    </p>

    <p class="downloads">
      Read the accord:
      <a href="#accord">on this page</a>
      <a href="/downloads/accord.md" download>Markdown</a>
      <a href="/downloads/accord.pdf" download>PDF</a>
    </p>
  </section>

  <hr class="rule" />

  <!-- ─── Accord ─── -->
  <section id="accord" class="container-wide py-14 md:py-20">
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-[15rem_minmax(0,40rem)] lg:gap-20">
      <div class="lg:sticky lg:top-8 lg:self-start lg:max-h-[calc(100vh-4rem)] lg:overflow-y-auto">
        <AccordNav sections={sections} />
      </div>

      <div>
        <details class="mb-8 lg:hidden">
          <summary class="jump">Jump to section</summary>
          <ol class="mt-4 ml-0 pl-0 list-none text-sm leading-snug">
            {sections.filter((s) => s.number !== null).map((s) => (
              <li class="mb-2 grid grid-cols-[1.75rem_1fr] gap-1">
                <span class="text-[color:var(--color-faint)] font-bold" style="font-family: var(--font-display); font-feature-settings: 'tnum';">
                  {pad2(s.number!)}
                </span>
                <a href={`#${s.anchor}`}>{s.title}</a>
              </li>
            ))}
          </ol>
        </details>

        <div class="accord-body">
          {renderedAccord.map(({ entry, Content }) => {
            const { number, title, anchor } = entry.data;
            const isPreamble = number === null;
            return (
              <section id={anchor} class:list={['accord-section', { preamble: isPreamble }]}>
                {!isPreamble && (
                  <span class="section-num">§ {pad2(number!)} of 11</span>
                )}
                <h2>
                  <a href={`#${anchor}`} class="anchor">{title}</a>
                </h2>
                <Content />
              </section>
            );
          })}

          <section class="endorse" id="endorse" aria-labelledby="endorse-heading">
            <h2 id="endorse-heading">Endorse</h2>
            <p>
              Endorsement opens after the first wave of endorser conversations. If you are a
              researcher, model developer, infrastructure provider, civil society organization,
              enterprise, or standards body considering endorsement, write to
              <a href="mailto:endorse@openslm.ai">endorse@openslm.ai</a>.
            </p>
          </section>

          <div class="closing">
            <p><em>Initial signatories: opens with the first endorser conversations.</em></p>
            <p><em>Released under CC0. Translate, adapt, republish. Endorse by signing. Build according to the principles.</em></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <!-- ─── Code ─── -->
  <section id="code" class="container-page py-14 md:py-20 prose">
    <p class="eyebrow">§ Code</p>
    <h2>Engineering work</h2>
    <p class="lede">
      Open infrastructure for running, evaluating, and composing small models — a runtime
      toolkit for constrained hardware, a disclosure schema, and a public registry that
      records what is open and what is not.
    </p>

    <h3>mobile-ai-toolkit</h3>
    <p>
      A toolkit for running small language models on mobile and other constrained
      hardware, with a focus on local-first inference, deterministic action boundaries,
      and inspectable runtime behavior.
      <strong>Status:</strong> active development.
      <a href="https://github.com/openslm-ai/mobile-ai-toolkit">Repository</a>.
    </p>

    <h3>LWD-R schema</h3>
    <p>
      A machine-readable schema for describing a release's openness across the four
      layers of the accord — Logic, Weights, Data, and Representation. Each release
      publishes a disclosure document; the schema defines what the disclosure must
      contain so that independent parties can compare claims across releases.
      <strong>Status:</strong> planned. Repository link forthcoming.
    </p>

    <h3>Public registry</h3>
    <p>
      A registry that collects LWD-R disclosures from signatories and renders them as a
      public, queryable record. The registry is the mechanism by which endorsement
      becomes something that can be checked rather than asserted.
      <strong>Status:</strong> planned. Repository link forthcoming.
    </p>
  </section>

  <hr class="rule" />

  <!-- ─── Research ─── -->
  <section id="research" class="container-page py-14 md:py-20 prose">
    <p class="eyebrow">§ Research</p>
    <h2>Theoretical and analytical work</h2>
    <p class="lede">
      The accord rests on a body of theoretical work on corrigibility, action
      boundaries, and evaluation methodology. Forthcoming papers will be published with
      reproducible artifacts and linked here.
    </p>

    <h3>Corrigibility framework</h3>
    <p>
      A framework for designing AI systems whose decisions can be inspected, contested,
      and overridden by the people they affect. The framework distinguishes
      architectural corrigibility (deterministic boundaries imposed outside the model)
      from behavioral corrigibility (the model's cooperation with correction), and
      argues that only the first produces accountability.
      <strong>Status:</strong> drafts forthcoming. Read the in-progress writing at
      <a href="https://anivar.net/corrigibility">anivar.net/corrigibility</a>. ArXiv DOIs
      will be added once the papers are public.
    </p>

    <h3>Related directions</h3>
    <p>
      The accord draws on the OSI Open Source AI Definition (§2 in particular), Princeton's
      research on AI agent reliability, and the emerging Agentic Skills specification work
      on composable, inspectable agent capabilities. See <a href="#references">References</a>
      below.
    </p>
  </section>

  <hr class="rule" />

  <!-- ─── References ─── -->
  <section id="references" class="container-page py-14 md:py-20 prose">
    <p class="eyebrow">§ References</p>
    <h2>Lineage and citations</h2>
    <p class="lede">
      Standards, organizations, and writing the accord draws on. The complete list is
      in preparation; what follows is the starting set.
    </p>

    <ul class="ref-list">
      {refs.map((r) => (
        <li>
          <div class="ref-title">
            {r.data.url ? <a href={r.data.url}>{r.data.title}</a> : r.data.title}
          </div>
          <div class="ref-meta">
            {[r.data.authors?.join(', '), r.data.year].filter(Boolean).join(', ')}
            {r.data.type && (
              <span class="text-[color:var(--color-faint)]"> · {r.data.type}</span>
            )}
          </div>
          <p class="m-0 mt-2 text-sm">
            {r.data.note}
            {r.data.relevance && r.data.relevance.length > 0 && (
              <span class="text-[color:var(--color-faint)]">
                {' '}[§{r.data.relevance.join(', §')}]
              </span>
            )}
          </p>
        </li>
      ))}
    </ul>

    <p class="text-sm text-[color:var(--color-muted)] mt-6">
      To suggest a citation, open an issue on
      <a href="https://github.com/openslm-ai/website">openslm-ai/website</a>.
    </p>
  </section>

  <hr class="rule" />

  <!-- ─── About ─── -->
  <section id="about" class="container-page py-14 md:py-20 prose">
    <p class="eyebrow">§ About</p>
    <h2>About this initiative</h2>
    <p class="lede">
      openslm.ai is an initiative to make small language models, and the systems that
      run them, open in a way that holds up — inspectable, reproducible, and
      correctable by the people they affect.
    </p>

    <p>
      The initiative is founded and initiated by
      <a href="https://anivar.net">Anivar Aravind</a>, a longtime contributor to free
      software, language technology, and digital rights, with a focus on open
      infrastructure for non-English-speaking users.
    </p>

    <h3>Contact</h3>
    <p>
      General inquiries: <a href="mailto:hello@openslm.ai">hello@openslm.ai</a>.
      Endorsement inquiries: <a href="mailto:endorse@openslm.ai">endorse@openslm.ai</a>.
      Code and issues: <a href="https://github.com/openslm-ai">github.com/openslm-ai</a>.
    </p>

    <h3>Get involved</h3>
    <ul>
      <li>Open an issue or pull request on <a href="https://github.com/openslm-ai">github.com/openslm-ai</a>.</li>
      <li>Send a note to <a href="mailto:hello@openslm.ai">hello@openslm.ai</a> to discuss the accord, contribute code, or work on the research.</li>
      <li>Endorse the accord once endorsement opens after the first wave of conversations.</li>
    </ul>
  </section>

</BaseLayout>
