---
import { getCollection, render } from 'astro:content';
import AccordLayout from '../../layouts/AccordLayout.astro';

const entries = await getCollection('accord');
entries.sort((a, b) => a.data.order - b.data.order);

const sections = entries.map((e) => ({
  number: e.data.number,
  title: e.data.title,
  anchor: e.data.anchor,
}));

// Pre-render every entry's MDX
const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
---

<AccordLayout
  title="The Open Small Models Accord"
  description="A standards document on open, accessible, and correctable AI for the next decade."
  sections={sections}>
  <header class="mb-8 pb-6 border-b border-[color:var(--color-rule)]">
    <h1 class="text-3xl md:text-[2.1rem] font-bold leading-tight m-0 mb-2">
      The Open Small Models Accord
    </h1>
    <p class="italic text-[color:var(--color-muted)] text-lg m-0" style="font-family: var(--font-serif);">
      On open, accessible, and correctable AI for the next decade
    </p>
  </header>

  <p class="downloads">
    Download:
    <a href="/downloads/accord.md" download>Markdown</a>
    <a href="/downloads/accord.pdf" download>PDF</a>
  </p>

  <details class="mb-8 lg:hidden">
    <summary class="cursor-pointer text-[color:var(--color-muted)] text-sm font-semibold uppercase tracking-wider">
      Jump to section
    </summary>
    <ol class="mt-3 ml-0 pl-5 text-sm leading-relaxed">
      {sections.filter((s) => s.number !== null).map((s) => (
        <li class="mb-1"><a href={`#${s.anchor}`}>{s.title}</a></li>
      ))}
    </ol>
  </details>

  <div class="accord-body">
    {rendered.map(({ entry, Content }) => {
      const { number, title, anchor } = entry.data;
      const isPreamble = number === null;
      return (
        <section id={anchor} class="accord-section">
          <h2>
            {isPreamble ? (
              <a href={`#${anchor}`} class="anchor">{title}</a>
            ) : (
              <a href={`#${anchor}`} class="anchor">
                <span class="num">{number}.</span>{title}
              </a>
            )}
          </h2>
          <Content />
        </section>
      );
    })}

    <section class="endorse" id="endorse" aria-labelledby="endorse-heading">
      <h2 id="endorse-heading">Endorse</h2>
      <p>
        Endorsement opens after the first wave of endorser conversations. If you are a
        researcher, model developer, infrastructure provider, civil society organization,
        enterprise, or standards body considering endorsement, write to
        <a href="mailto:endorse@openslm.ai">endorse@openslm.ai</a>.
      </p>
    </section>

    <div class="closing">
      <p><em>Initial signatories: opens with the first endorser conversations.</em></p>
      <p><em>Released under CC0. Translate, adapt, republish. Endorse by signing. Build according to the principles.</em></p>
    </div>
  </div>
</AccordLayout>
