---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AccordNav from '../components/AccordNav.astro';
import AccordSeal from '../components/AccordSeal.astro';
import EndorseFootnote from '../components/EndorseFootnote.astro';
import {
  VERSION,
  LABEL,
  STATE,
  ISSUED,
  ISSUED_ISO,
  AUTHOR,
  TITLE,
  pillLabel,
} from '../lib/accord-meta.mjs';

const issuedYear = ISSUED_ISO.slice(0, 4);
const shortVersion = VERSION.replace(/\.0$/, '');
const sealVersion = `v${shortVersion}`;
const accordUrl = 'https://openslm.ai/accord/';
const stateLabel = STATE === 'canonical' ? '' : STATE;
const versionFull = stateLabel ? `${shortVersion}, ${stateLabel}` : shortVersion;

const nameParts = AUTHOR.name.split(' ');
const last = nameParts.slice(-1)[0];
const given = nameParts.slice(0, -1).join(' ');
const initial = given[0];

const cite = {
  bibtex: `@misc{${last.toLowerCase()}${issuedYear}openslm,
  author = {${last}, ${given}},
  title  = {{${TITLE}}, version ${versionFull}},
  year   = {${issuedYear}},
  url    = {${accordUrl}},
  note   = {Released under CC0 1.0}
}`,
  apa: `${last}, ${initial}. (${issuedYear}). ${TITLE} (Version ${versionFull}). ${accordUrl}`,
  chicago: `${last}, ${given}. "${TITLE}." Version ${versionFull}. ${ISSUED}. ${accordUrl}`,
};

const accordEntries = await getCollection('accord');
accordEntries.sort((a, b) => a.data.order - b.data.order);

const sections = accordEntries.map((e) => ({
  number: e.data.number,
  title: e.data.title,
  anchor: e.data.anchor,
}));

const renderedAccord = await Promise.all(
  accordEntries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

const pad2 = (n: number) => n.toString().padStart(2, '0');

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'The Accord', url: '/accord/' },
];

const heroPill = pillLabel();
const [pillNum, ...pillRest] = heroPill.split(' · ');
const pillTail = pillRest.join(' · ');
void STATE;
void VERSION;
---

<BaseLayout
  title="The Accord"
  description={`The Open Small Models Accord — principles for open, accessible, and correctable AI. Version ${LABEL}. Released under CC0 1.0.`}
  ogType="article"
  publishedTime={`${ISSUED_ISO}T00:00:00Z`}
  modifiedTime={`${ISSUED_ISO}T00:00:00Z`}
  breadcrumbs={breadcrumbs}>

  <section id="top" class="hero hero--accord">
    <div class="container-page hero__inner hero__inner--masthead">
      <div class="masthead__text">
        <p class="hero__meta">
          <span class="hero__pill"><span class="hero__pill-num">{pillNum}</span> · {pillTail}</span>
          <span class="hero__dot" aria-hidden="true">·</span>
          <time datetime={ISSUED_ISO}>Issued {ISSUED}</time>
          <span class="hero__dot" aria-hidden="true">·</span>
          <a href="/version-history/" class="hero__history">Version history</a>
        </p>

        <h1 class="hero__title">The Open Small<br />Models Accord</h1>
        <p class="hero__subtitle">
          On open, accessible, and correctable AI for the next decade.
        </p>

        <nav class="hero__formats" aria-label="Available formats">
          <span class="hero__formats-label">Read in</span>
          <ul>
            <li><span class="format format--current" aria-current="page">HTML</span></li>
            <li><a href="/downloads/accord.md" download class="format">Markdown</a></li>
            <li><a href="/downloads/accord.pdf" download class="format">PDF</a></li>
          </ul>

          <details class="cite">
            <summary class="cite__summary">
              <span>Cite</span>
              <svg class="cite__chev" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                <path d="M2 4 L5 7 L8 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="cite__panel" role="group" aria-label="Citation formats">
              <div class="cite__row">
                <div class="cite__head">
                  <span class="cite__label">BibTeX</span>
                  <button type="button" class="cite__copy" data-copy-target="cite-bibtex">Copy</button>
                </div>
                <pre class="cite__src" id="cite-bibtex">{cite.bibtex}</pre>
              </div>
              <div class="cite__row">
                <div class="cite__head">
                  <span class="cite__label">APA</span>
                  <button type="button" class="cite__copy" data-copy-target="cite-apa">Copy</button>
                </div>
                <pre class="cite__src" id="cite-apa">{cite.apa}</pre>
              </div>
              <div class="cite__row">
                <div class="cite__head">
                  <span class="cite__label">Chicago</span>
                  <button type="button" class="cite__copy" data-copy-target="cite-chicago">Copy</button>
                </div>
                <pre class="cite__src" id="cite-chicago">{cite.chicago}</pre>
              </div>
            </div>
          </details>
        </nav>
      </div>

      <aside class="masthead__seal" aria-hidden="true">
        <AccordSeal version={sealVersion} year={issuedYear} />
      </aside>
    </div>
  </section>

  <div class="section-mark" aria-hidden="true">§</div>

  <section id="accord-body" class="container-wide py-14 md:py-20">
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-[15rem_minmax(0,40rem)] lg:gap-20">
      <div class="lg:sticky lg:top-8 lg:self-start lg:max-h-[calc(100vh-4rem)] lg:overflow-y-auto">
        <AccordNav sections={sections} />
      </div>

      <div>
        <details class="mb-8 lg:hidden">
          <summary class="jump">Jump to section</summary>
          <ol class="mt-4 ml-0 pl-0 list-none text-sm leading-snug">
            {sections.filter((s) => s.number !== null).map((s) => (
              <li class="mb-2 grid grid-cols-[1.75rem_1fr] gap-1">
                <span class="text-[color:var(--color-faint)] font-bold" style="font-family: var(--font-display); font-feature-settings: 'tnum';">
                  {pad2(s.number!)}
                </span>
                <a href={`#${s.anchor}`}>{s.title}</a>
              </li>
            ))}
          </ol>
        </details>

        <div class="accord-body">
          <div class="accord-stamp" aria-label="Document metadata">
            <span class="accord-stamp__row">
              <span class="accord-stamp__k">Version</span>
              <span class="accord-stamp__v">{LABEL}</span>
            </span>
            <span class="accord-stamp__row">
              <span class="accord-stamp__k">Issued</span>
              <span class="accord-stamp__v">
                <time datetime={ISSUED_ISO}>{ISSUED}</time>
              </span>
            </span>
            <span class="accord-stamp__row">
              <span class="accord-stamp__k">License</span>
              <span class="accord-stamp__v">
                <a href="https://creativecommons.org/publicdomain/zero/1.0/" rel="license">CC0&nbsp;1.0</a>
              </span>
            </span>
          </div>

          {renderedAccord.map(({ entry, Content }) => {
            const { number, title, anchor } = entry.data;
            const isPreamble = number === null;
            return (
              <section id={anchor} class:list={['accord-section', { preamble: isPreamble }]}>
                {!isPreamble && (
                  <span class="section-num">§ {pad2(number!)}</span>
                )}
                <h2>
                  <a href={`#${anchor}`} class="anchor">{title}</a>
                </h2>
                <Content />
              </section>
            );
          })}

          <EndorseFootnote />

          <div class="closing">
            <p><em>Translate, adapt, republish. Endorse by signing. Build according to the principles.</em></p>
          </div>

          <aside class="attribution" id="attribution" aria-label="Attribution">
            <h3>Attribution</h3>
            <p>
              The Open Small Models Accord, version {LABEL}, issued
              <time datetime={ISSUED_ISO}>{ISSUED}</time>, authored by
              <a href="https://anivar.net">Anivar Aravind</a>. Hosted at
              <a href="/">openslm.ai</a>. Released under
              <a href="https://creativecommons.org/publicdomain/zero/1.0/" rel="license">CC0&nbsp;1.0</a>.
            </p>
            <p>
              For answers to common questions, see the <a href="/faq/">FAQ</a>.
              Translations are listed at <a href="/translations/">/translations</a>.
            </p>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var buttons = document.querySelectorAll('.cite__copy[data-copy-target]');
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.getAttribute('data-copy-target');
          var src = id ? document.getElementById(id) : null;
          if (!src) return;
          var text = src.textContent || '';
          var done = function () {
            var prev = btn.textContent;
            btn.setAttribute('data-copied', 'true');
            btn.textContent = 'Copied';
            setTimeout(function () {
              btn.removeAttribute('data-copied');
              btn.textContent = prev;
            }, 1400);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done, function () {});
          } else {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); done(); } catch (e) {}
            document.body.removeChild(ta);
          }
        });
      });
    })();
  </script>

</BaseLayout>
