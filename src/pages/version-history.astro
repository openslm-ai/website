---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  VERSION,
  LABEL,
  STATE,
  ISSUED,
  ISSUED_ISO,
  pillLabel,
} from '../lib/accord-meta.mjs';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Version history', url: '/version-history/' },
];

const upcoming = [
  {
    version: '0.5',
    label: 'Revised draft',
    when: 'after review by the invited set of practitioners',
    summary:
      'Integrates substantive feedback from the invited reviewers. Compliance-path mechanics clarified; safety section sharpened.',
  },
  {
    version: '0.9',
    label: 'Release candidate',
    when: 'after open comment',
    summary:
      'Substantively final document. A short open comment window precedes endorsement.',
  },
  {
    version: '1.0',
    label: 'Canonical',
    when: 'with founding endorsers',
    summary:
      'Formal release with founding signatories. Subsequent revision happens through the versioned process described in §10.',
  },
];

const stateLabel = ({ draft: 'Draft', rc: 'Release candidate', canonical: 'Canonical' } as const)[STATE as 'draft' | 'rc' | 'canonical'] ?? STATE;
void pillLabel;
---

<BaseLayout
  title="Version history"
  description="The Open Small Models Accord is a versioned document. Each version is a public artifact. Past versions live in git history."
  breadcrumbs={breadcrumbs}>

  <section class="hero hero--page">
    <div class="container-page hero__inner">
      <p class="hero__eyebrow">Version history</p>
      <h1 class="hero__title">From draft<br />toward canonical</h1>
      <p class="hero__lede">
        The accord is a versioned document. Each version is a discrete public
        artifact &mdash; not a git commit. Versions move from draft (0.x) through
        release candidate (0.9) to canonical (1.0), then onward through the
        revision process described in &sect;&nbsp;10.
      </p>
    </div>
  </section>

  <div class="section-mark" aria-hidden="true">&sect;</div>

  <section class="container-page py-14 md:py-20">

    <h2 class="vh-h">Current version</h2>
    <ol class="vh-list">
      <li class="vh-item is-current">
        <div class="vh-head">
          <span class="vh-num">v{VERSION.replace(/\.0$/, '')}</span>
          <span class={`status-pill status-pill--${STATE === 'canonical' ? 'active' : 'planned'}`}>
            {stateLabel}
          </span>
          <span class="vh-date">
            <time datetime={ISSUED_ISO}>{ISSUED}</time>
          </span>
        </div>
        <p class="vh-summary">
          {STATE === 'canonical'
            ? `Canonical text. Released ${ISSUED} as ${LABEL}.`
            : `Working draft, ${LABEL}. Open for comment.`}
        </p>
        <ul class="vh-notes">
          <li><a href="/accord/">Read the current text</a></li>
          <li><a href="/downloads/accord.md" download>Download Markdown</a></li>
          <li><a href="/downloads/accord.pdf" download>Download PDF</a></li>
        </ul>
      </li>
    </ol>

    <h2 class="vh-h">Planned versions</h2>
    <p class="vh-process-note">
      The path from draft to canonical moves through a small number of public revisions.
      Each version is a discrete public artifact.
    </p>
    <ol class="vh-list">
      {upcoming.map((v) => (
        <li class="vh-item is-upcoming">
          <div class="vh-head">
            <span class="vh-num">v{v.version}</span>
            <span class="status-pill status-pill--planned">{v.label}</span>
            <span class="vh-date">{v.when}</span>
          </div>
          <p class="vh-summary">{v.summary}</p>
        </li>
      ))}
    </ol>

    <h2 class="vh-h">Past versions</h2>
    <p class="vh-process-note">
      Past versions are not catalogued on this site. They live in the version-control
      history as tagged releases, each with the markdown and PDF as it shipped.
    </p>
    <ul class="vh-archive">
      <li>
        <a href="https://github.com/openslm-ai/website/releases">GitHub releases</a>
        <span class="vh-archive__hint"> &mdash; tagged versions with downloadable assets</span>
      </li>
      <li>
        <a href="https://github.com/openslm-ai/website/commits/main/src/content/accord">
          Commit history of the accord text
        </a>
        <span class="vh-archive__hint"> &mdash; line-level changes to the source MDX</span>
      </li>
    </ul>

    <p class="vh-tail">
      Comments on the current draft are welcome at
      <a href="https://github.com/openslm-ai/website/issues">github.com/openslm-ai/website/issues</a>
      or by writing to <a href="mailto:hello@openslm.ai">hello@openslm.ai</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .vh-h {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    margin: 3rem 0 1rem;
    letter-spacing: -0.005em;
  }

  .vh-process-note {
    font-size: 0.95rem;
    color: var(--color-muted);
    max-width: 38rem;
    margin: 0 0 1.5rem;
  }

  .vh-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .vh-item {
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-rule);
  }

  .vh-item:last-child { border-bottom: 1px solid var(--color-rule); }

  .vh-item.is-current {
    background: color-mix(in srgb, var(--color-accent) 4%, transparent);
    padding-inline: 1.25rem;
    margin-inline: -1.25rem;
    border-left: 3px solid var(--color-accent);
  }

  .vh-head {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 0.65rem;
  }

  .vh-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--color-fg);
    font-feature-settings: 'tnum';
  }

  .vh-date {
    font-size: 0.82rem;
    color: var(--color-faint);
    font-style: italic;
  }

  .vh-summary {
    margin: 0 0 0.65rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-fg);
    max-width: 38rem;
  }

  .vh-notes {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .vh-notes li { margin-bottom: 0.25rem; }

  .vh-archive {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    font-size: 0.92rem;
  }

  .vh-archive li {
    padding: 0.65rem 0;
    border-top: 1px solid var(--color-rule);
  }

  .vh-archive li:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .vh-archive a {
    font-weight: 600;
    color: var(--color-fg);
  }

  .vh-archive__hint {
    color: var(--color-muted);
    font-size: 0.86rem;
  }

  .vh-tail {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-rule);
    font-size: 0.9rem;
    color: var(--color-muted);
  }
</style>
