---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/zilla-slab/700.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description = 'OpenSLM.ai — principles for open, accessible, and correctable AI. Home of the Open Small Models Accord.',
  ogType = 'website',
  ogImage: ogImageProp,
  publishedTime,
  modifiedTime,
  breadcrumbs,
} = Astro.props;

const siteName = 'OpenSLM.ai';
const fullTitle = title
  ? `${title} — ${siteName}`
  : `OpenSLM.ai — Open, accessible, correctable AI`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(ogImageProp ?? '/og.png', Astro.site).toString();

const isAccordPage = Astro.url.pathname.startsWith('/accord');
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

const breadcrumbJsonLd = breadcrumbs && breadcrumbs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(b.url, Astro.site).toString(),
      })),
    }
  : null;

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: 'https://openslm.ai/',
  inLanguage: 'en',
  publisher: { '@type': 'Organization', name: siteName, url: 'https://openslm.ai/' },
};

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'OpenSLM.ai',
  url: 'https://openslm.ai/',
  logo: 'https://openslm.ai/icon-512.png',
  founder: {
    '@type': 'Person',
    name: 'Anivar Aravind',
    url: 'https://anivar.net',
  },
  description:
    'An initiative for open, accessible, and correctable small language models. Home of the Open Small Models Accord.',
  sameAs: ['https://github.com/openslm-ai'],
};

const accordJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'The Open Small Models Accord',
  alternativeHeadline:
    'On open, accessible, and correctable AI for the next decade',
  inLanguage: 'en',
  datePublished: '2026-04-06',
  dateModified: '2026-04-06',
  version: '0.1',
  author: {
    '@type': 'Person',
    name: 'Anivar Aravind',
    url: 'https://anivar.net',
  },
  publisher: {
    '@type': 'Organization',
    name: 'OpenSLM.ai',
    url: 'https://openslm.ai/',
  },
  url: 'https://openslm.ai/accord/',
  license: 'https://creativecommons.org/publicdomain/zero/1.0/',
  about: ['Open source AI', 'Small language models', 'AI policy', 'Corrigibility'],
  isAccessibleForFree: true,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="open source AI, small language models, AI policy, corrigibility, LWD-R, OpenSLM, AI accord, open weights, AI standards" />
    <meta name="author" content="Anivar Aravind" />
    <meta name="theme-color" content="#fafaf7" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/markdown" title="OpenSLM accord (Markdown)" href="/downloads/accord.md" />
    <link rel="alternate" type="text/plain" title="LLM-friendly site summary" href="/llms.txt" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="The Open Small Models Accord — OpenSLM.ai" />
    <meta property="og:locale" content="en_US" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && (
      <meta property="article:author" content="https://anivar.net" />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="The Open Small Models Accord — OpenSLM.ai" />

    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    {(isAccordPage || isHome) && (
      <script type="application/ld+json" set:html={JSON.stringify(accordJsonLd)} />
    )}
    {breadcrumbJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    )}

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
